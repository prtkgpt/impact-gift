{
  "rewrites": [
    {
      "source": "/event/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|whatsapp|facebookexternalhit|twitterbot|telegrambot|slackbot|discordbot|linkedinbot|pinterestbot|preview|embedly|quora|outbrain|vkshare|redditbot)"
        }
      ],
      "destination": "/api/og/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
